# Puerto del servidor
PORT=3000

# URL pública donde va a vivir el sitio una vez deployado (sin barra final)
# Ejemplo: https://tiendakodo.com  o  https://kodo.onrender.com
PUBLIC_URL=http://localhost:3000

# Credenciales del panel admin
ADMIN_USER=tu_usuario_admin
ADMIN_PASS=una_contrasena_larga_y_unica

# Secreto para firmar la cookie de sesión del admin (poné algo largo y random en producción)
SESSION_SECRET=cambiar-esto-por-un-secreto-largo-y-random

# Access Token de Mercado Pago (Producción). Se consigue en:
# https://www.mercadopago.com.uy/developers/panel/app
# ¡OJO! Este token es secreto, nunca lo subas a git ni lo compartas.
MP_ACCESS_TOKEN=TU_ACCESS_TOKEN_DE_MERCADO_PAGO
